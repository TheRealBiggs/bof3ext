<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeLib>Shared</NativeLib>
    <OutputType>Library</OutputType>
    <RootNamespace>BoF3Ext</RootNamespace>
    <Nullable>enable</Nullable>
    <PublishDir>$(MSBuildThisFileDirectory)..\build\$(Configuration)\</PublishDir>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AssemblyName>bof3ext</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1701;1702;0649;0169</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="res\shaders\basic_shader.fs.glsl" />
    <EmbeddedResource Include="res\shaders\basic_shader.vs.glsl" />
    <EmbeddedResource Include="res\shaders\psx_shader.fs.glsl" />
    <EmbeddedResource Include="res\shaders\psx_shader.vs.glsl" />
    <EmbeddedResource Include="res\shaders\replaced_texture_shader.fs.glsl" />
    <EmbeddedResource Include="res\shaders\replaced_texture_shader.vs.glsl" />
    <EmbeddedResource Include="res\shaders\text_shader.fs.glsl" />
    <EmbeddedResource Include="res\shaders\text_shader.vs.glsl" />
    
    <None Update="res\bof3ext.json" TargetPath="bof3ext.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  
  <ItemGroup>
    <DirectPInvoke Include="minhook" />
    <DirectPInvoke Include="freetype" />
    <DirectPInvoke Include="stb_image" />
    <DirectPInvoke Include="stb_image_write" Condition="'$(Configuration)' == 'Debug'" />
    
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\lib\minhook.x86.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\lib\freetype.x86.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\lib\stb_image.x86.lib" />
    <NativeLibrary Include="$(MSBuildThisFileDirectory)..\lib\stb_image_write.x86.lib" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\BoF3Ext.Generators\BoF3Ext.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PublishAotCompressed" Version="1.0.5" PrivateAssets="all"
                      Condition="'$(Configuration)' == 'Release'" />
    <PackageReference Include="Silk.NET.Core" Version="2.23.0" ExcludeAssets="all" />
    <PackageReference Include="Silk.NET.Input.Common" Version="2.23.0" ExcludeAssets="all" />
    <PackageReference Include="Silk.NET.Windowing.Common" Version="2.23.0" ExcludeAssets="all" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <SilkProject Include="..\modules\silk.net\src\Core\Silk.NET.Core\Silk.NET.Core.csproj"
                 Framework="net6.0" Overrides="Silk.NET.Core" />
    <SilkProject Include="..\modules\silk.net\src\Windowing\Silk.NET.Windowing.Common\Silk.NET.Windowing.Common.csproj"
                 Framework="netstandard2.1" Overrides="Silk.NET.Platforms" />
    <SilkProject Include="..\modules\silk.net\src\Input\Silk.NET.Input.Common\Silk.NET.Input.Common.csproj"
                 Framework="net6.0" Overrides="Silk.NET.Platforms" />
    <Reference Include="Silk.NET.Core">
      <HintPath>..\modules\silk.net\src\Core\Silk.NET.Core\bin\$(Configuration)\net6.0\Silk.NET.Core.dll</HintPath>
    </Reference>
    <Reference Include="Silk.NET.Windowing.Common">
      <HintPath>..\modules\silk.net\src\Windowing\Silk.NET.Windowing.Common\bin\$(Configuration)\netstandard2.1\Silk.NET.Windowing.Common.dll</HintPath>
    </Reference>
    <Reference Include="Silk.NET.Input.Common">
      <HintPath>..\modules\silk.net\src\Input\Silk.NET.Input.Common\bin\$(Configuration)\net6.0\Silk.NET.Input.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="BuildSilkProjects" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <MSBuild Projects="@(SilkProject)" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;
                         TargetFramework=%(SilkProject.Framework);TargetFrameworks=%(SilkProject.Framework);
                         DirectoryBuildTargetsPath=$(MSBuildThisFileDirectory)..\deps\%(SilkProject.Overrides)\%(SilkProject.Overrides).targets;
                         NuGetPackageRoot=$(NuGetPackageRoot);SilkSourceLinkExempt=true;SilkPublicApiExempt=true;BuildProjectReferences=false" />
  </Target>

</Project>
